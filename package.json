{
  "name": "overpass-proxy",
  "version": "1.5.0",
  "description": "Amenity-focused Overpass API proxy with Redis tile caching.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "cross-env USE_DOCKER=0 vitest run",
    "test:watch": "cross-env USE_DOCKER=0 vitest",
    "test:docker": "cross-env USE_DOCKER=1 vitest run",
    "test:ci": "cross-env USE_DOCKER=0 vitest run --coverage",
    "test:perf:statistics": "tsx src/tests/perf/statistics-refresh-latency.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "got": "^14.6.5",
    "ioredis": "^5.8.2",
    "ngeohash": "^0.6.0",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "supertest": "^7.1.4",
    "testcontainers": "^11.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
