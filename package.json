{
  "name": "overpass-proxy",
  "version": "1.6.0",
  "description": "Amenity-focused Overpass API proxy with Redis tile caching.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:build": "npm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "cross-env USE_DOCKER=0 vitest run",
    "test:watch": "cross-env USE_DOCKER=0 vitest",
    "test:docker": "cross-env USE_DOCKER=1 vitest run",
    "test:ci": "cross-env USE_DOCKER=0 vitest run --coverage",
    "test:perf:statistics": "tsx src/tests/perf/statistics-refresh-latency.ts",
    "verify": "npm run lint && npm run test:build && npm test",
    "test:smoke:docker": "bash scripts/smoke-docker.sh",
    "test:perf:statistics-worker": "tsx src/tests/perf/statistics-worker-bounded.ts"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "got": "^14.6.5",
    "ioredis": "^5.8.2",
    "ngeohash": "^0.6.0",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
